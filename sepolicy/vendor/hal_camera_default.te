add_service(hal_camera_default, hal_nt_camera_aidl_service)

allow hal_camera_default fwk_camera_hwservice:hwservice_manager find;

binder_call(hal_camera_default, hal_camera_default)
binder_call(hal_camera_default, platform_app)

get_prop(hal_camera_default, camera_config_prop)
set_prop(hal_camera_default, vendor_camera_prop)
